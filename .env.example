# Copy to .env (never commit .env) and add the same values in Vercel:
# Project -> Settings -> Environment Variables.

# CoinMarketCap Pro API key. https://coinmarketcap.com/api -> dashboard -> API key.
# Use the key tied to the email you registered on DoraHacks with (for the Startup upgrade).
CMC_API_KEY=

# Google Gemini API key (free tier). https://aistudio.google.com/apikey
# Used only to pull claims out of post text. Without it, a simpler regex extractor is used.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Upstash Redis (free tier). Easiest: Vercel -> Storage -> Upstash for Redis -> connect to
# the project; Vercel then adds these for you. For local dev, copy them from the Upstash console.
# Without them, results are kept in memory (lost on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any long random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it to /api/keepalive.
CRON_SECRET=
