{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/r/:id", "destination": "/index.html" }],
  "crons": [{ "path": "/api/keepalive", "schedule": "0 6 * * *" }]
}
